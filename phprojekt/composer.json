{
    "name": "mayflower/phprojekt",
    "version": "6.3.0-dev",
    "description": "PHProjekt",
    "license": "LGPL-3.0+",
    "require": {
        "php": ">=8.0",
        "laminas/laminas-mvc": "^3.6",
        "laminas/laminas-db": "^2.19",
        "laminas/laminas-session": "^2.16",
        "laminas/laminas-authentication": "^2.14",
        "laminas/laminas-cache": "^3.11",
        "laminas/laminas-cache-storage-adapter-filesystem": "^2.3",
        "laminas/laminas-cache-storage-adapter-memory": "^2.2",
        "laminas/laminas-config": "^3.8",
        "laminas/laminas-filter": "^2.31",
        "laminas/laminas-form": "^3.10",
        "laminas/laminas-i18n": "^2.22",
        "laminas/laminas-json": "^3.5",
        "laminas/laminas-log": "^2.16",
        "laminas/laminas-mail": "^2.23",
        "laminas/laminas-router": "^3.11",
        "laminas/laminas-validator": "^2.38",
        "laminas/laminas-view": "^2.32",
        "laminas/laminas-servicemanager": "^3.21",
        "laminas/laminas-component-installer": "^3.2",
        "sabre/dav": "^4.4",
        "laminas/laminas-zendframework-bridge": "^1.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "Application\\": "application/",
            "Phprojekt\\": "library/Phprojekt/",
            "Setup\\": "htdocs/",
            "Cleaner\\": "library/Cleaner/"
        },
        "psr-0": {
            "Phprojekt_": "library/",
            "Zend_": "library/",
            "Project_": "application/Project/",
            "Calendar2_": "application/Calendar2/",
            "Timecard_": "application/Timecard/",
            "Default_": "application/Default/",
            "Core_": "application/Core/"
        },
        "files": [
            "library/Phprojekt.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "laminas/laminas-component-installer": true
        },
        "platform": {
            "php": "8.3.0"
        }
    }
}
