{
  "name": "phprojekt-e2e-tests",
  "version": "1.0.0",
  "description": "End-to-end tests for PHProjekt 6 using Playwright",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:codegen": "playwright codegen"
  },
  "keywords": [
    "e2e",
    "playwright",
    "testing"
  ],
  "author": "PHProjekt Team",
  "license": "LGPL-3.0",
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.9.0",
    "dotenv": "^16.4.5"
  }
}
